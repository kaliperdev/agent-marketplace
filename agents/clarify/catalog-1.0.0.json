{
  "format": 1,
  "id": "clarify",
  "version": "1.0.0",
  "kind": "mcp",
  "service": {
    "url": "https://api.clarify.ai/mcp",
    "timeout_seconds": 60
  },
  "needs_router": "0.6.0",
  "publisher": "Kaliper",
  "display": {
    "name": "Clarify",
    "summary": "Reads Clarify CRM records, meetings, lists, campaigns, and pipeline analytics.",
    "categories": [
      "CRM"
    ],
    "logo": {
      "letter": "C",
      "color": "#101626",
      "image": "data:image/png;base64,"
    },
    "examples": [
      "Which deals moved this week?",
      "Summarize our meetings with Acme.",
      "What is our win rate over the last 90 days?"
    ]
  },
  "connection": {
    "method": "signin",
    "provider": "Clarify",
    "note": "Sign in with the Clarify account for the organization you want to connect, then choose that organization on the authorization screen.",
    "signin": {
      "client": "automatic"
    },
    "fields": []
  },
  "router": {
    "source": "clarify",
    "source_config": {},
    "agent": {
      "name": "clarify",
      "source": "clarify",
      "tools": [
        "get-current-user",
        "get-schema",
        "query-data",
        "query-analytics",
        "get-records",
        "get-lists",
        "get-campaigns"
      ],
      "description": "Reads the signed-in Clarify workspace's CRM records, meetings, campaigns, and historical analytics. This catalog exposes only read tools.",
      "owns": "You own Clarify CRM records visible to the signed-in user. Use get-schema to discover entities, query-data or query-analytics for searches, and get-records for full details. You cannot create or update records in this catalog. Include Clarify record links when available. You do not own other CRMs.",
      "holds_documents": false
    },
    "tool_descriptions": {
      "get-current-user": "Get the signed-in user's profile, timezone, and current local time.",
      "get-schema": "Inspect Clarify's built-in and custom entity schema before querying records.",
      "query-data": "Search and analyze companies, people, deals, meetings, tasks, users, and comments.",
      "query-analytics": "Query historical analytics and metrics with read-only SQL.",
      "get-records": "Read full records by ID, including relationships and AI summaries.",
      "get-lists": "Browse saved lists for an entity type or read a list by ID.",
      "get-campaigns": "List campaigns or read a campaign by ID."
    }
  }
}
