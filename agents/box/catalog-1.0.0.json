{
  "format": 1,
  "id": "box",
  "version": "1.0.0",
  "kind": "mcp",
  "service": {
    "url": "https://mcp.box.com",
    "timeout_seconds": 60,
    "max_result_chars": 200000
  },
  "needs_router": "0.7.0",
  "publisher": "Kaliper",
  "display": {
    "name": "Box",
    "summary": "Searches and reads Box files through Box's official hosted MCP server.",
    "categories": [
      "Documents",
      "Files"
    ],
    "logo": {
      "letter": "B",
      "color": "#0061D5",
      "image": "data:image/svg+xml;base64,"
    },
    "examples": [
      "Find the customer contract in Box.",
      "List files in the finance folder.",
      "Read the latest policy document."
    ]
  },
  "connection": {
    "method": "signin",
    "provider": "Box",
    "signin": {
      "client": "automatic"
    },
    "fields": []
  },
  "router": {
    "source": "box",
    "source_config": {},
    "agent": {
      "name": "box",
      "source": "box",
      "tools": [
        "search_files",
        "list_folder",
        "get_file_metadata",
        "get_file_content"
      ],
      "description": "Searches and reads Box files through Box's official hosted MCP server.",
      "owns": "You own Box files and folders authorized for this account. This agent does not delete or modify files.",
      "holds_documents": true,
      "first_for": "Box hosted MCP workflows"
    },
    "tool_descriptions": {
      "search_files": "Search Box files.",
      "list_folder": "List files in a Box folder.",
      "get_file_metadata": "Read file metadata.",
      "get_file_content": "Read Box file content."
    }
  }
}
