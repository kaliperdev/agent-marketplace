{
  "format": 1,
  "id": "stripe",
  "version": "1.0.0",
  "kind": "mcp",
  "service": {
    "url": "https://mcp.stripe.com",
    "timeout_seconds": 60,
    "max_result_chars": 200000
  },
  "needs_router": "0.7.0",
  "publisher": "Kaliper",
  "display": {
    "name": "Stripe",
    "summary": "Reads Stripe customers, payments, invoices, and products through Stripe's official hosted MCP server.",
    "categories": [
      "Payments",
      "Billing"
    ],
    "logo": {
      "letter": "S",
      "color": "#635BFF",
      "image": "data:image/svg+xml;base64,"
    },
    "examples": [
      "Find the latest payment from Acme.",
      "List unpaid invoices.",
      "Show the customer record for jane@example.com."
    ]
  },
  "connection": {
    "method": "signin",
    "provider": "Stripe",
    "signin": {
      "client": "automatic"
    },
    "fields": []
  },
  "router": {
    "source": "stripe",
    "source_config": {},
    "agent": {
      "name": "stripe",
      "source": "stripe",
      "tools": [
        "search_customers",
        "list_payments",
        "list_invoices",
        "get_product",
        "create_refund"
      ],
      "description": "Reads Stripe customers, payments, invoices, and products through Stripe's official hosted MCP server.",
      "owns": "You own Stripe billing data available to this account. Refunds and other financial mutations require confirmation.",
      "holds_documents": false,
      "first_for": "Stripe hosted MCP workflows",
      "writes": [
        "create_refund"
      ]
    },
    "tool_descriptions": {
      "search_customers": "Search Stripe customers.",
      "list_payments": "List recent payments.",
      "list_invoices": "List invoices and payment status.",
      "get_product": "Read a Stripe product.",
      "create_refund": "Create a refund after confirmation."
    }
  }
}
