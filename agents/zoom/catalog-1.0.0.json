{
  "format": 1,
  "id": "zoom",
  "version": "1.0.0",
  "kind": "mcp",
  "service": {
    "url": "https://zoom.us/mcp/meeting/streamable",
    "timeout_seconds": 60,
    "max_result_chars": 200000
  },
  "needs_router": "0.7.0",
  "publisher": "Kaliper",
  "display": {
    "name": "Zoom Meetings",
    "summary": "Reads and manages Zoom meetings through Zoom's official hosted MCP server.",
    "categories": [
      "Meetings",
      "Scheduling"
    ],
    "logo": {
      "letter": "Z",
      "color": "#2D8CFF",
      "image": "data:image/svg+xml;base64,"
    },
    "examples": [
      "List my upcoming Zoom meetings.",
      "Create a Zoom meeting for tomorrow.",
      "Find the recording for last week's meeting."
    ]
  },
  "connection": {
    "method": "signin",
    "provider": "Zoom Meetings",
    "signin": {
      "client": "automatic"
    },
    "fields": []
  },
  "router": {
    "source": "zoom",
    "source_config": {},
    "agent": {
      "name": "zoom",
      "source": "zoom",
      "tools": [
        "list_meetings",
        "get_meeting",
        "create_meeting",
        "update_meeting",
        "delete_meeting"
      ],
      "description": "Reads and manages Zoom meetings through Zoom's official hosted MCP server.",
      "owns": "You own Zoom meetings and recordings available through this account. Creating, updating, or deleting meetings requires confirmation.",
      "holds_documents": false,
      "first_for": "Zoom Meetings hosted MCP workflows",
      "writes": [
        "create_meeting",
        "update_meeting",
        "delete_meeting"
      ]
    },
    "tool_descriptions": {
      "list_meetings": "List upcoming or recent Zoom meetings.",
      "get_meeting": "Read details for a Zoom meeting.",
      "create_meeting": "Create a Zoom meeting after confirmation.",
      "update_meeting": "Update a Zoom meeting after confirmation.",
      "delete_meeting": "Delete a Zoom meeting after confirmation."
    }
  }
}
