{
  "format": 1,
  "id": "freshdesk",
  "version": "1.0.0",
  "kind": "mcp",
  "service": {
    "image": "kaliper/agent-freshdesk:1.0.0",
    "port": 8080,
    "timeout_seconds": 60
  },
  "needs_router": "0.7.0",
  "publisher": "Kaliper",
  "display": {
    "name": "Freshdesk",
    "summary": "Reads support tickets, conversations, contacts, and companies in one Freshdesk account.",
    "categories": [
      "Tickets",
      "CRM"
    ],
    "logo": {
      "letter": "F",
      "color": "#FFFFFF",
      "image": "data:image/svg+xml;base64,"
    },
    "examples": [
      "What is the latest update on ticket 123?",
      "Find open tickets about login issues."
    ]
  },
  "connection": {
    "method": "form",
    "fields": [
      {
        "key": "FRESHDESK_SUBDOMAIN",
        "label": "Freshdesk subdomain",
        "type": "text",
        "required": true,
        "placeholder": "demo",
        "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
        "patternHelp": "The subdomain only, without https:// or .freshdesk.com"
      },
      {
        "key": "FRESHDESK_API_KEY",
        "label": "Freshdesk API key",
        "type": "password",
        "required": true,
        "help": "Enter the key in this web form, never in Slack."
      }
    ]
  },
  "router": {
    "source": "freshdesk",
    "source_config": {},
    "agent": {
      "name": "freshdesk",
      "source": "freshdesk",
      "tools": [
        "fetch_ticket",
        "fetch_tickets",
        "search_tickets",
        "fetch_ticket_conversations",
        "fetch_contact",
        "fetch_contacts",
        "search_contacts",
        "fetch_company",
        "search_companies",
        "fetch_search_companies"
      ],
      "description": "Reads support tickets, ticket conversations, contacts, and companies from the connected Freshdesk account. No write tools are exposed.",
      "owns": "You own the connected Freshdesk account's ticket and contact data. You can read and search. You cannot create, update, or delete records, or send replies."
    },
    "tool_descriptions": {
      "fetch_ticket": "Read one support ticket.",
      "fetch_tickets": "List support tickets.",
      "search_tickets": "Search support tickets.",
      "fetch_ticket_conversations": "Read a ticket's conversation history.",
      "fetch_contact": "Read one contact.",
      "fetch_contacts": "List contacts.",
      "search_contacts": "Search contacts by name.",
      "fetch_company": "Read one company.",
      "search_companies": "Search companies by name.",
      "fetch_search_companies": "Search companies using their fields."
    }
  }
}
