{
  "format": 1,
  "id": "mongodb-atlas",
  "version": "1.0.0",
  "kind": "mcp",
  "service": {
    "url": "https://mcp.mongodb.com",
    "timeout_seconds": 60,
    "max_result_chars": 200000
  },
  "needs_router": "0.7.0",
  "publisher": "Kaliper",
  "display": {
    "name": "MongoDB Atlas",
    "summary": "Reads MongoDB Atlas collections and documents through MongoDB's official hosted MCP server.",
    "categories": [
      "Database"
    ],
    "logo": {
      "letter": "M",
      "color": "#001E2B",
      "image": "data:image/svg+xml;base64,"
    },
    "examples": [
      "List my Atlas databases.",
      "Describe the users collection.",
      "Find users created this week."
    ]
  },
  "connection": {
    "method": "signin",
    "provider": "MongoDB Atlas",
    "signin": {
      "client": "automatic"
    },
    "fields": []
  },
  "router": {
    "source": "mongodb-atlas",
    "source_config": {},
    "agent": {
      "name": "mongodb-atlas",
      "source": "mongodb-atlas",
      "tools": [
        "list_databases",
        "list_collections",
        "describe_collection",
        "find_documents"
      ],
      "description": "Reads MongoDB Atlas collections and documents through MongoDB's official hosted MCP server.",
      "owns": "You own MongoDB Atlas data visible to this account. This agent is read-only and cannot insert, update, or delete documents.",
      "holds_documents": false,
      "first_for": "MongoDB Atlas hosted MCP workflows"
    },
    "tool_descriptions": {
      "list_databases": "List accessible Atlas databases.",
      "list_collections": "List collections in a database.",
      "describe_collection": "Describe a collection schema.",
      "find_documents": "Find documents using a read-only query."
    }
  }
}
