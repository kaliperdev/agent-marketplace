{
  "format": 1,
  "id": "amplitude",
  "version": "1.0.0",
  "kind": "mcp",
  "service": {
    "url": "https://mcp.amplitude.com/mcp",
    "timeout_seconds": 60
  },
  "needs_router": "0.7.0",
  "publisher": "Kaliper",
  "display": {
    "name": "Amplitude",
    "summary": "Queries Amplitude product analytics and manages dashboards for the signed-in organization.",
    "categories": [
      "Analytics"
    ],
    "logo": {
      "letter": "A",
      "color": "#1D6EF2",
      "image": "data:image/svg+xml;base64,"
    },
    "examples": [
      "What drove signup conversion this month?",
      "Compare retention between these cohorts.",
      "Add this analysis to an Amplitude dashboard."
    ]
  },
  "connection": {
    "method": "signin",
    "provider": "Amplitude",
    "signin": {
      "client": "automatic"
    },
    "fields": []
  },
  "router": {
    "source": "amplitude",
    "source_config": {},
    "agent": {
      "name": "amplitude",
      "source": "amplitude",
      "tools": [
        "get_amplitude_context",
        "query_amplitude_data",
        "use_amp_dashboards"
      ],
      "description": "Reads Amplitude project context, runs product analytics, and manages dashboards for the signed-in organization.",
      "owns": "You own Amplitude analytics and dashboards visible to this account. Read project context before querying. Dashboard changes require confirmation. You do not ingest production events.",
      "holds_documents": false,
      "first_for": "Amplitude product analytics, funnels, retention, and dashboards",
      "writes": [
        "use_amp_dashboards"
      ]
    },
    "tool_descriptions": {
      "get_amplitude_context": "Read organization and project context, including business definitions and rules configured in Amplitude.",
      "query_amplitude_data": "Run an Amplitude analytics query such as segmentation, funnel, retention, or experiment analysis.",
      "use_amp_dashboards": "Create or edit Amplitude dashboards and their content. This can change Amplitude."
    }
  }
}
